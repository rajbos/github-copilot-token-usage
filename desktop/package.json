{
  "name": "ai-engineering-fluency-desktop",
  "version": "0.1.0",
  "description": "AI Engineering Fluency - Windows Desktop App",
  "author": "RobBos",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "start": "npm run build && electron .",
    "pack": "npm run build:production && electron-builder --dir",
    "dist": "npm run build:production && electron-builder --win nsis --publish never",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^26.6.4",
    "chalk": "^6.0.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.12",
    "tar": ">=7.5.21"
  },
  "build": {
    "appId": "com.rajbos.ai-engineering-fluency",
    "productName": "AI Engineering Fluency",
    "artifactName": "AI-Engineering-Fluency-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/rajbos/ai-engineering-fluency/releases/download/desktop-latest/"
    }
  },
  "allowScripts": {
    "electron@42.4.1": true,
    "esbuild@0.25.12": true
  }
}
