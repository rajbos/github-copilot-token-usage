visualstudio-extension/src/AIEngineeringFluency/cli-bundle/
# Generated webview bundles (esbuild output copied from vscode-extension/dist/webview
# at build time by CopyWebviewBundles in AIEngineeringFluency.csproj). Scoped to the
# generated file types only — see docs/adr/VS-WEBVIEW-BUNDLE-SOURCING.md.
visualstudio-extension/src/AIEngineeringFluency/webview/*.js
visualstudio-extension/src/AIEngineeringFluency/webview/*.json
visualstudio-extension/src/AIEngineeringFluencyRunner/bin/
visualstudio-extension/src/AIEngineeringFluencyRunner/obj/
visualstudio-extension/src/AIEngineeringFluencyRunner/cli-bundle/
visualstudio-extension/visualstudio-extension/src/AIEngineeringFluencyRunner/obj/
visualstudio-extension/src/AIEngineeringFluency/obj/project.nuget.cache
visualstudio-extension/src/AIEngineeringFluency.Tests/bin/
visualstudio-extension/src/AIEngineeringFluency.Tests/obj/
visualstudio-extension/TestResults/
vscode-extension/.session_secret.txt
visualstudio-extension/.idea/

# JetBrains IDE (plugin workspace and sandbox)
jetbrains-plugin/.idea/
jetbrains-plugin/build/
jetbrains-plugin/build/idea-sandbox/
jetbrains-plugin/.kotlin/
jetbrains-plugin/.gradle/
# ignore any IDEA project files anywhere
**/.idea/
# IntelliJ sandbox directories
**/idea-sandbox/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Terraform (local runs only — CI uses ephemeral runners and a remote backend,
# but local bootstrap runs like sharing-server/infra/bootstrap leave these
# behind; state files can contain plaintext secrets, never commit them)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
crash.log
crash.*.log

# Graphify output. manifest.json + cache/ ARE committed so a fresh clone or cloud
# agent can run `graphify --update` from a warm cache instead of a full rescan.
# Everything else (graph.json/html, GRAPH_REPORT.md, cost.json) is regenerable, and
# .graphify_python/.graphify_root are absolute machine-specific paths — never commit those.
graphify-out/*
!graphify-out/manifest.json
!graphify-out/cache/
!graphify-out/cache/**

# Stray/misplaced graphify cache (wrong working directory on a past run)
src/graphify-out/

# Graphify graph built by copilot-setup-steps for the Copilot coding agent
# (GRAPHIFY_OUT=.graphify-agent). Kept out of the default graphify-out/ so the
# build never touches the committed manifest.json / cache/ above.
.graphify-agent/

# AI Engineering Fluency canvas (copilot-app/) writes its snapshot and refresh lock to
# $COPILOT_HOME/extensions/ai-fluency/artifacts/, never into the repo. This is
# the backstop so a copy run from a checkout can never commit personal usage data.
copilot-app/**/artifacts/
copilot-app/**/snapshot.json
copilot-app/**/refresh.lock
copilot-app/**/refresh.lock.*

# Visual view-diff output (screenshots, diff images and reports produced by
# .github/skills/visual-view-diff). Regenerable from any checkout — the fixtures
# that drive the renders are committed, the rendered PNGs are not.
visual-output/

# pr-risk-review skill scratch output (changeset facts, verdict, rendered
# comment). Regenerated on every run by collect-changeset.js — never committed.
pr-risk/

# Data hydrated into the workspace by copilot-setup-steps (session-logs/ from
# Azure Blob, usage-data/ incl. agent-sessions.json and its cache files). Generated
# output, recreated on demand — never committed.
session-logs/
usage-data/

# Throwaway fixture directories created by the vscode-extension unit suite.
# The tests create these under os.tmpdir(), or under .test-fixtures/ where the
# subject refuses to read out of the temp directory, and clean them up (see
# vscode-extension/test/unit/tmpFixtureDirs.ts). These patterns are the backstop
# for a run that crashed or was interrupted before cleanup, so a stray one can
# never be swept into a commit by `git add -A`.
vscode-extension/.test-fixtures/
vscode-extension/claude-test-*/
vscode-extension/sync-test-*/
vscode-extension/cowork-test-*/
vscode-extension/cliapp-split-*/
vscode-extension/contract-fixture-*/
vscode-extension/ctt-cache-*/
vscode-extension/ctt-dev-cleanup-*/
vscode-extension/ctt-lock-test-*/
vscode-extension/ctt-rollups-*/
vscode-extension/ctt-snapshot-*/
vscode-extension/ctt-snapshot-test-*/
vscode-extension/pi-test-*/
vscode-extension/pi-discover-*/
vscode-extension/ctt-otel-test-*/
