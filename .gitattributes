# Enforce consistent line endings across platforms
# Default: LF for all text files
* text=auto eol=lf

# Windows script files should use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# jetbrains-plugin gradlew.bat: store byte-for-byte, no line-ending conversion.
# Dependabot's gradle-wrapper bumps commit the file with CRLF straight from the
# Gradle distribution. Under the *.bat rule above git then wants to normalize it,
# so it shows as modified in every checkout and breaks stash/pop on Linux runners
# (PR #1463 / issue #1445). A bare "text" override does not cancel eol=crlf, so
# the file is marked -text instead: what is committed is what is checked out.
jetbrains-plugin/gradlew.bat -text

# Keep images and binaries untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
