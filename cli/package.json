{
  "name": "@rajbos/ai-engineering-fluency",
  "version": "0.7.0",
  "description": "AI Engineering Fluency - CLI and Node library to analyze token usage, cost and fluency from local AI coding session files (GitHub Copilot, Claude Code, Gemini CLI, Codex CLI, OpenCode and more)",
  "license": "MIT",
  "author": "RobBos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajbos/ai-engineering-fluency.git",
    "directory": "cli"
  },
  "keywords": [
    "github-copilot",
    "token-usage",
    "copilot",
    "cli",
    "token-tracker",
    "claude-code",
    "gemini-cli",
    "codex",
    "ai-usage",
    "library"
  ],
  "bin": {
    "ai-engineering-fluency": "dist/cli.js"
  },
  "exports": {
    "./session": {
      "import": {
        "types": "./dist/lib/session.d.mts",
        "default": "./dist/lib/session.mjs"
      },
      "require": {
        "types": "./dist/lib/session.d.ts",
        "default": "./dist/lib/session.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "bundle-exe": "pwsh -NoProfile -File bundle-exe.ps1",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "node dist/cli.js --help && node dist/cli.js --version && npm run test:unit",
    "test:unit": "node esbuild.tests.js && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^26.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "esbuild": "^0.28.0",
    "sql.js": "^1.12.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
