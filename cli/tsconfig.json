{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "../vscode-extension/node_modules/@types"
    ],
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": false,
    "skipLibCheck": true,
    "paths": {
      "../src/*": ["../src/*"],
      "@msgpack/msgpack": ["./node_modules/@msgpack/msgpack/dist.esm/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../src/types.ts",
    "../src/cachePolicy.ts",
    "../src/sessionDiscovery.ts",
    "../src/sessionParser.ts",
    "../src/dailyAttribution.ts",
    "../src/tokenEstimation.ts",
    "../src/workspaceHelpers.ts",
    "../src/statsHelpers.ts",
    "../src/adapters/**/*.ts",
    "../src/modelPricing.json",
    "../src/toolCuration.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../vscode-extension/node_modules",
    "../src/copilotCliStore.ts",
    "../src/crush.ts",
    "../src/opencode.ts"
  ]
}
