  </ItemGroup>
  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.6.36389" ExcludeAssets="runtime" NoWarn="NU1604" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.6.2164" NoWarn="NU1604" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35" />
    <PackageReference Include="Community.VisualStudio.Toolkit" Version="17.0.76.303" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Pinned to override vulnerable transitive versions pulled in via the VS SDK (Dependabot alerts #138-150) -->
    <PackageReference Include="MessagePack" Version="2.5.301" />
    <PackageReference Include="Microsoft.IO.Redist" Version="6.0.1" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
  <!--
    Clear the experimental-instance MEF / command-table cache so VSCT and
    package-registration changes are always picked up on F5.
    Only runs in Debug builds. Safe to fail (e.g. first run, no Exp hive yet).
  -->
  <Target Name="ClearExpCache" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="for /d %%d in (&quot;$(LocalAppData)\Microsoft\VisualStudio\17.0_*Exp&quot;) do ( if exist &quot;%%d\ComponentModelCache&quot; rd /s /q &quot;%%d\ComponentModelCache&quot; )"
          IgnoreExitCode="true"
          ContinueOnError="true" />
    <Message Importance="high" Text="Cleared experimental-instance ComponentModelCache." />
  </Target>

  <!--
    Copy webview JS bundles from the vscode-extension build output into this project's
    webview\ folder so they can be packaged inside the VSIX.
    Prerequisite: run `npm run compile` in vscode-extension/ first.
  -->
  <!--
    CopyWebviewBundles is skippable for environments that build the C# project
    for extraction/analysis only and don't have the vscode-extension webview
    build output checked out (notably the CodeQL C# scan, which sparse-checkouts
    only visualstudio-extension/). Pass /p:CopyWebviewBundles=false to skip it.
  -->
  <Target Name="CopyWebviewBundles" BeforeTargets="Build" Condition="'$(CopyWebviewBundles)' != 'false'">
    <ItemGroup>
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\details.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\chart.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\usage.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\diagnostics.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\environmental.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\maturity.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\fluency-level-viewer.js" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\tokenEstimators.json" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\modelPricing.json" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\toolNames.json" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\automaticTools.json" />
      <!--
        Resolved webview string dictionaries, one per shipped locale. The bundles only
        localize themselves if the host puts one in the panel payload, and this extension
        is C# so it cannot build one from package.nls*.json itself. Without these, the
        reused bundles render their built-in English fallback whatever language VS is in.
      -->
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\localization.en.json" />
      <_WebviewBundle Include="..\..\..\vscode-extension\dist\webview\localization.zh-cn.json" />
      <!--
        The Scoring Guide (fluency-level-viewer) reads its rubric straight from the shared
        source JSON; unlike the four above it is not needed by the VS Code webviews at
        runtime, so esbuild does not stage it in dist/webview/ and we copy it from src/.
      -->
      <_WebviewBundle Include="..\..\..\src\fluencyLevelData.json" />
    </ItemGroup>
    <!--
      Fail the build loudly when ANY of the freshly-built bundles is absent. There is no
      committed fallback under webview\*.js any more (see docs/adr/VS-WEBVIEW-BUNDLE-SOURCING.md)
      — the dist/webview build is the ONLY source of webview content, so a missing input means
      the Copy below silently ships a VSIX with partial or no webview content: a green build
      with a broken product. Build vscode-extension first (npm run package) or use
      ./build.ps1 -Project visualstudio, which rebuilds the bundles automatically.

      Every item in _WebviewBundle is checked, not just one representative file — a
      probe on a single bundle would pass while the other nine were missing.
    -->
    <ItemGroup>
      <_MissingWebviewBundle Include="@(_WebviewBundle)" Condition="!Exists('%(_WebviewBundle.FullPath)')" />
    </ItemGroup>
    <Error
      Condition="'@(_MissingWebviewBundle)' != ''"
      Text="vscode-extension/dist/webview bundle(s) not found: @(_MissingWebviewBundle->'%(Filename)%(Extension)', ', ') — nothing to package into webview\ (no committed fallback exists). Run 'npm run package' in vscode-extension/ or build via ./build.ps1 -Project visualstudio." />
    <Warning
      Condition="!Exists('$(MSBuildProjectDirectory)\cli-bundle\copilot-token-tracker.exe')"
      Text="cli-bundle/copilot-token-tracker.exe not found — the VSIX will have NO bundled CLI and will show empty/zero usage data. Run ./build.ps1 -Project visualstudio to build and copy the CLI exe." />
    <MakeDir Directories="$(MSBuildProjectDirectory)\webview" />
    <!--
      ContinueOnError is safe here specifically because the Error above already stopped the
      build when dist/webview is missing — by the time this Copy runs, the source files are
      known to exist, so a failure here would be an unexpected I/O error (e.g. a locked file)
      worth a warning + Message rather than aborting the whole build outright.
    -->
    <Copy SourceFiles="@(_WebviewBundle)" DestinationFolder="$(MSBuildProjectDirectory)\webview\" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Copied webview bundles from vscode-extension/dist/webview/." />

  </Target>
  <!--
    Copy webview files to the output directory so the extension DLL can find them when
    loaded from bin\Debug or bin\Release (not from the VSIX). VSIX packaging is handled
    separately by the AddWebviewBundlesToVsix target below (see its comment for why a
    top-level wildcard Content Include is not used for that part).
  -->
  <ItemGroup>
    <Content Include="webview\*.js" Condition="Exists('$(MSBuildProjectDirectory)\webview')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="webview\*.json" Condition="Exists('$(MSBuildProjectDirectory)\webview')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    Copy cli-bundle files to the output directory so the extension DLL can find them
    when loaded from bin\Debug or bin\Release (not from the VSIX).
    VSIX packaging is handled separately by the AddCliBundleToVsix target below.
  -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\cli-bundle\copilot-token-tracker.exe"
             Condition="Exists('$(MSBuildProjectDirectory)\cli-bundle\copilot-token-tracker.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cli-bundle\copilot-token-tracker.exe</Link>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)\cli-bundle\sql-wasm.wasm"
             Condition="Exists('$(MSBuildProjectDirectory)\cli-bundle\sql-wasm.wasm')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cli-bundle\sql-wasm.wasm</Link>
    </Content>
  </ItemGroup>

  <!--
    Add the bundled CLI exe and associated wasm into the VSIX by directly injecting
    VSIXSourceItem entries immediately before GetVsixSourceItems collects them.

    Why BeforeTargets="GetVsixSourceItems" and NOT BeforeTargets="Build":
      CreateVsixContainer is triggered by PrepareForRun (not Build). The CopyWebviewBundles
      target (BeforeTargets="Build") does NOT run in the PrepareForRun path, so any Content
      items added there are invisible to GetVsixSourceItems.

    Why we also delete $(FileManifest) (files.json):
      GenerateFileManifest has only Outputs (no Inputs), so it is skipped whenever
      files.json already exists — even if the item list has changed. Deleting it here
      (when cli-bundle is present) forces GenerateFileManifest to regenerate files.json
      with the cli-bundle entries included, so VsixUtil packages them correctly.
  -->
  <Target Name="AddCliBundleToVsix" BeforeTargets="GetVsixSourceItems">
    <!-- Force files.json to regenerate so cli-bundle entries are included. -->
    <Delete Files="$(FileManifest)"
            Condition="Exists('$(MSBuildProjectDirectory)\cli-bundle\copilot-token-tracker.exe') AND Exists('$(FileManifest)')" />
    <ItemGroup>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\cli-bundle\copilot-token-tracker.exe"
                      Condition="Exists('$(MSBuildProjectDirectory)\cli-bundle\copilot-token-tracker.exe')">
        <VSIXSubPath>cli-bundle\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\cli-bundle\sql-wasm.wasm"
                      Condition="Exists('$(MSBuildProjectDirectory)\cli-bundle\sql-wasm.wasm')">
        <VSIXSubPath>cli-bundle\</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!--
    Add the webview JS bundles + JSON sidecar files into the VSIX by directly injecting
    VSIXSourceItem entries immediately before GetVsixSourceItems collects them, instead of
    the top-level wildcard `Content Include="webview\*.js"` this project used previously.

    Why: this is a classic (non-SDK-style) .csproj, where a top-level wildcard <ItemGroup>
    expands once at project EVALUATION, before any target — including CopyWebviewBundles
    (BeforeTargets="Build") — has run. On a checkout where webview\*.js does not already
    exist on disk before MSBuild starts, that wildcard evaluates to zero items, and the
    VSIX silently ships no webview content. Explicitly enumerating the known bundle names
    here (as CopyWebviewBundles's _WebviewBundle list already does) removes the dependency
    on evaluation-time file presence, the same fix already applied to the CLI bundle above.
    See the "Why BeforeTargets=GetVsixSourceItems" comment on AddCliBundleToVsix for why
    BeforeTargets="Build" alone is not enough for VSIX packaging either.

    Status: the committed webview\*.js/*.json fallback has been removed (see
    docs/adr/VS-WEBVIEW-BUNDLE-SOURCING.md) — this target is now the ONLY source of webview
    content in the VSIX. webview\ is populated solely by CopyWebviewBundles from a fresh
    vscode-extension/dist/webview build; see that target's Error for what happens if it's
    missing. THE ACTUAL VSIX-PACKAGING BEHAVIOR OF THIS TARGET HAS NOT BEEN VERIFIED ON A
    REAL MSBUILD/WINDOWS BUILD — see the release gate in the ADR before shipping.
  -->
  <Target Name="AddWebviewBundlesToVsix" BeforeTargets="GetVsixSourceItems">
    <!-- Force files.json to regenerate so webview entries are included (see AddCliBundleToVsix above for why). -->
    <Delete Files="$(FileManifest)"
            Condition="Exists('$(MSBuildProjectDirectory)\webview\details.js') AND Exists('$(FileManifest)')" />
    <ItemGroup>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\details.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\details.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\chart.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\chart.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\usage.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\usage.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\diagnostics.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\diagnostics.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\environmental.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\environmental.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\maturity.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\maturity.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\fluency-level-viewer.js"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\fluency-level-viewer.js')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\tokenEstimators.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\tokenEstimators.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\modelPricing.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\modelPricing.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\toolNames.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\toolNames.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\automaticTools.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\automaticTools.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\localization.en.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\localization.en.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\localization.zh-cn.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\localization.zh-cn.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\webview\fluencyLevelData.json"
                      Condition="Exists('$(MSBuildProjectDirectory)\webview\fluencyLevelData.json')">
        <VSIXSubPath>webview\</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
</Project>