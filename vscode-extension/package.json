      },
      {
        "command": "aiEngineeringFluency.showEfficiency",
        "title": "%command.showEfficiency.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showWhatsNew",
        "title": "%command.showWhatsNew.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.authenticateGitHub",
        "title": "%command.authenticateGitHub.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.signOutGitHub",
        "title": "%command.signOutGitHub.title%",
