      },
      {
        "command": "copilot-token-tracker.checkWindsurfStatus",
        "title": "%command.checkWindsurfStatus.title%",
        "category": "AI Engineering Fluency"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "aiEngineeringFluency.display.compactNumbers": {
          "type": "boolean",
          "default": true,
          "description": "%config.display.compactNumbers.description%"
        },
        "aiEngineeringFluency.display.use24HourTime": {
          "type": "boolean",
          "default": true,
          "description": "%config.display.use24HourTime.description%"
        },
        "aiEngineeringFluency.display.hideAutomaticToolCalls": {
          "type": "boolean",
          "default": true,
          "description": "%config.display.hideAutomaticToolCalls.description%"
        },
        "aiEngineeringFluency.display.statusBar.showTokens": {
          "type": "string",
          "enum": [
            "none",
            "today",
            "last30days",
            "currentMonth",
            "both",
            "todayAndCurrentMonth"
          ],
          "enumDescriptions": [
            "%config.display.statusBar.showTokens.enum.none%",
            "%config.display.statusBar.showTokens.enum.today%",
            "%config.display.statusBar.showTokens.enum.last30days%",
            "%config.display.statusBar.showTokens.enum.currentMonth%",
            "%config.display.statusBar.showTokens.enum.both%",
            "%config.display.statusBar.showTokens.enum.todayAndCurrentMonth%"
          ],
          "default": "both",
          "description": "%config.display.statusBar.showTokens.description%"
        },
        "aiEngineeringFluency.display.statusBar.showCost": {
          "type": "string",
          "enum": [
            "none",
            "today",
            "last30days",
            "currentMonth",
            "both",
            "todayAndCurrentMonth"
          ],
          "enumDescriptions": [
            "%config.display.statusBar.showCost.enum.none%",
            "%config.display.statusBar.showCost.enum.today%",
            "%config.display.statusBar.showCost.enum.last30days%",
            "%config.display.statusBar.showCost.enum.currentMonth%",
            "%config.display.statusBar.showCost.enum.both%",
            "%config.display.statusBar.showCost.enum.todayAndCurrentMonth%"
          ],
          "default": "none",
          "description": "%config.display.statusBar.showCost.description%"
        },
        "aiEngineeringFluency.display.statusBar.monthlyBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.display.statusBar.monthlyBudget.description%"
        },
        "aiEngineeringFluency.backend.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.backend.enabled.description%"
        },
        "aiEngineeringFluency.backend.backend": {
          "type": "string",
          "enum": [
            "storageTables",
            "sharingServer"
          ],
          "enumDescriptions": [
            "%config.backend.backend.enum.storageTables%",
            "%config.backend.backend.enum.sharingServer%"
          ],
          "default": "storageTables",
          "description": "%config.backend.backend.description%"
        },
        "aiEngineeringFluency.backend.authMode": {
          "type": "string",
          "enum": [
            "entraId",
            "sharedKey"
          ],
          "default": "entraId",
          "description": "%config.backend.authMode.description%"
        },
        "aiEngineeringFluency.backend.datasetId": {
          "type": "string",
          "default": "default",
          "description": "%config.backend.datasetId.description%"
        },
        "aiEngineeringFluency.backend.sharingProfile": {
          "type": "string",
          "enum": [
            "off",
            "soloFull",
            "teamAnonymized",
            "teamPseudonymous",
            "teamIdentified"
          ],
          "enumDescriptions": [
            "%config.backend.sharingProfile.enum.off%",
            "%config.backend.sharingProfile.enum.soloFull%",
            "%config.backend.sharingProfile.enum.teamAnonymized%",
            "%config.backend.sharingProfile.enum.teamPseudonymous%",
            "%config.backend.sharingProfile.enum.teamIdentified%"
          ],
          "default": "off",
          "description": "%config.backend.sharingProfile.description%"
        },
        "aiEngineeringFluency.backend.userId": {
          "type": "string",
          "default": "",
          "description": "%config.backend.userId.description%"
        },
        "aiEngineeringFluency.backend.shareWithTeam": {
          "type": "boolean",
          "default": false,
          "description": "%config.backend.shareWithTeam.description%"
        },
        "aiEngineeringFluency.backend.shareWorkspaceMachineNames": {
          "type": "boolean",
          "default": false,
          "description": "%config.backend.shareWorkspaceMachineNames.description%"
        },
        "aiEngineeringFluency.backend.shareConsentAt": {
          "type": "string",
          "default": "",
          "description": "%config.backend.shareConsentAt.description%"
        },
        "aiEngineeringFluency.backend.userIdentityMode": {
          "type": "string",
          "enum": [
            "pseudonymous",
            "teamAlias",
            "entraObjectId"
          ],
          "default": "pseudonymous",
          "description": "%config.backend.userIdentityMode.description%"
        },
        "aiEngineeringFluency.backend.userIdMode": {
          "type": "string",
          "enum": [
            "alias",
            "custom"
          ],
          "default": "alias",
          "description": "%config.backend.userIdMode.description%"
        },
        "aiEngineeringFluency.backend.subscriptionId": {
          "type": "string",
          "default": "",
          "description": "%config.backend.subscriptionId.description%"
        },
        "aiEngineeringFluency.backend.resourceGroup": {
          "type": "string",
          "default": "",
          "description": "%config.backend.resourceGroup.description%"
        },
        "aiEngineeringFluency.backend.storageAccount": {
          "type": "string",
          "default": "",
          "description": "%config.backend.storageAccount.description%"
        },
        "aiEngineeringFluency.backend.aggTable": {
          "type": "string",
          "default": "usageAggDaily",
          "description": "%config.backend.aggTable.description%"
        },
        "aiEngineeringFluency.backend.eventsTable": {
          "type": "string",
          "default": "usageEvents",
          "description": "%config.backend.eventsTable.description%"
        },
        "aiEngineeringFluency.backend.lookbackDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 90,
          "description": "%config.backend.lookbackDays.description%"
        },
        "aiEngineeringFluency.backend.includeMachineBreakdown": {
          "type": "boolean",
          "default": false,
          "description": "%config.backend.includeMachineBreakdown.description%"
        },
        "aiEngineeringFluency.backend.blobUploadEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.backend.blobUploadEnabled.description%"
        },
        "aiEngineeringFluency.backend.blobContainerName": {
          "type": "string",
          "default": "copilot-session-logs",
          "description": "%config.backend.blobContainerName.description%"
        },
        "aiEngineeringFluency.backend.blobUploadFrequencyHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "maximum": 168,
          "description": "%config.backend.blobUploadFrequencyHours.description%"
        },
        "aiEngineeringFluency.backend.blobCompressFiles": {
          "type": "boolean",
          "default": true,
          "description": "%config.backend.blobCompressFiles.description%"
        },
        "aiEngineeringFluency.backend.sharingServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.backend.sharingServer.enabled.description%"
        },
        "aiEngineeringFluency.backend.sharingServer.endpointUrl": {
          "type": "string",
          "default": "",
          "description": "%config.backend.sharingServer.endpointUrl.description%"
        },
        "aiEngineeringFluency.sampleDataDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.sampleDataDirectory.description%"
        },
        "aiEngineeringFluency.suppressedUnknownTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.suppressedUnknownTools.description%"
        },
        "aiEngineeringFluency.curation.timeWindowDays": {
          "type": "number",
          "default": 30,
          "enum": [
            7,
            30,
            90
          ],
          "enumDescriptions": [
            "%config.curation.timeWindowDays.enum.7%",
            "%config.curation.timeWindowDays.enum.30%",
            "%config.curation.timeWindowDays.enum.90%"
          ],
          "description": "%config.curation.timeWindowDays.description%"
        },
        "aiEngineeringFluency.toolFamilies": {
          "type": "array",
          "default": [],
          "description": "%config.toolFamilies.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "builtIn",
              "alternatives"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier used for override matching (e.g. 'reading'). Must be unique."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Tool Analysis tab."
              },
              "builtIn": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Built-in / baseline tool names that define the reference performance. Tool names must match exactly as they appear in session logs."
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Alternative or efficient-replacement tool names to compare against the built-ins."
              },
              "description": {
                "type": "string",
                "description": "Optional short description of this tool family."
              }
            }
          }
        },
        "aiEngineeringFluency.insights.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.insights.enabled.description%"
        },
        "aiEngineeringFluency.insights.toastsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.insights.toastsEnabled.description%"
        },
        "aiEngineeringFluency.whatsNew.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.whatsNew.notificationsEnabled.description%"
        },
        "aiEngineeringFluency.serverMemories.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.serverMemories.enabled.description%"
        },
        "aiEngineeringFluency.insights.cadenceDays": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 30,
          "description": "%config.insights.cadenceDays.description%"
        },
        "copilotTokenTracker.windsurf.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.copilotTokenTracker.windsurf.enabled.description%"
        },
        "copilotTokenTracker.windsurf.includeCascadeDetails": {
          "type": "boolean",
          "default": true,
          "description": "%config.copilotTokenTracker.windsurf.includeCascadeDetails.description%"
        },
        "copilotTokenTracker.windsurf.cacheCredentials": {
          "type": "boolean",
          "default": true,
          "description": "%config.copilotTokenTracker.windsurf.cacheCredentials.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "node esbuild.js",
    "validate": "pnpm run check-types && pnpm run lint && pnpm run compile",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "tsc --noEmit && pnpm run lint && node esbuild.js --production",
    "prepare-test-output": "node ../scripts/prepare-test-output.js",
    "compile-tests": "node ../scripts/prepare-test-output.js && tsc -p tsconfig.tests.json",
    "watch-tests": "tsc -p tsconfig.tests.json -w",
    "pretest": "tsc --noEmit && pnpm run lint && node ../scripts/prepare-test-output.js && tsc -p tsconfig.tests.json",
    "check-types": "tsc --noEmit",
    "validate:l10n": "node scripts/validate-l10n.mjs",
    "lint": "node scripts/check-lint-baseline.mjs",
    "lint:eslint": "eslint src ../src",
    "lint:baseline:update": "node scripts/check-lint-baseline.mjs --update-baseline",
    "lint:report": "eslint src ../src --format json",
    "lint:css": "stylelint \"src/webview/**/*.css\"",
    "lint:json": "node ../scripts/validate-json.js",
    "lint:l10n": "node ../scripts/validate-localization.js && node scripts/generate-webview-strings.mjs --check",
    "lint:hardcoded-strings": "node scripts/check-hardcoded-strings.mjs",
    "test:hardcoded-strings": "node --test scripts/check-hardcoded-strings.test.mjs",
    "lint:hardcoded-colors": "node scripts/check-hardcoded-colors.mjs",
    "test:hardcoded-colors": "node --test scripts/check-hardcoded-colors.test.mjs",
    "test:lint-baseline": "node --test scripts/check-lint-baseline.test.mjs",
    "test": "node ../scripts/run-node-unit-tests.js && pnpm run test:lint-baseline",
    "test:node": "node ../scripts/prepare-test-output.js && tsc -p tsconfig.tests.json && node ../scripts/run-node-unit-tests.js && pnpm run test:lint-baseline",
    "test:src": "node ../scripts/prepare-test-output.js && tsc -p tsconfig.tests.json && node --test --test-force-exit \"out/src/test/*.test.js\"",
    "test:coverage": "node ../scripts/prepare-test-output.js && tsc -p tsconfig.tests.json && node --require ./out/vscode-extension/test/unit/vscode-shim-register.js --experimental-test-coverage --test --test-force-exit --test-coverage-lines=88 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-include=out/vscode-extension/src/backend/**/*.js --test-coverage-include=out/vscode-extension/src/utils/**/*.js --test-coverage-include=out/src/utils/**/*.js --test-coverage-include=out/src/usageAnalysis.js --test-coverage-include=out/src/tokenEstimation.js --test-coverage-include=out/src/maturityScoring.js out/vscode-extension/test/unit/*.test.js",
    "test:coverage:ci": "node --require ./out/vscode-extension/test/unit/vscode-shim-register.js --experimental-test-coverage --test --test-force-exit --test-coverage-lines=88 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-include=out/vscode-extension/src/backend/**/*.js --test-coverage-include=out/vscode-extension/src/utils/**/*.js --test-coverage-include=out/src/utils/**/*.js --test-coverage-include=out/src/usageAnalysis.js --test-coverage-include=out/src/tokenEstimation.js --test-coverage-include=out/src/maturityScoring.js out/vscode-extension/test/unit/*.test.js",
    "test:mutation": "pnpm run compile-tests && pnpm exec stryker run",
    "package:pre-release": "tsc --noEmit && pnpm run lint && node esbuild.js --production && pnpm exec vsce package --pre-release",
    "pre-release": "node ../scripts/pre-release.js",
    "capture-screenshots": "pwsh -File ../scripts/capture-screenshots.ps1",
    "visual:render": "node ../.github/skills/visual-view-diff/render-views.js",
    "visual:diff": "node ../.github/skills/visual-view-diff/visual-diff.js",
    "check:contract": "node ../scripts/validate-webview-contract.js",
    "check:interaction": "node ../scripts/interaction-smoke.js",
    "check:editor-data": "node ../scripts/check-editor-data-coverage.js",
    "check:duplicates": "node ../scripts/check-code-duplication.js",
    "preflight": "node ../scripts/preflight.js",
    "preflight:quick": "node ../scripts/preflight.js --quick",
    "sync-changelog": "node ../scripts/sync-changelog.js",
    "sync-changelog:test": "node ../scripts/sync-changelog.js --test",
    "cli:build": "cd ../cli && pnpm install && pnpm run build",
    "cli:build:production": "cd ../cli && pnpm install && pnpm run build:production",
    "cli:stats": "cd ../cli && node dist/cli.js stats",
    "cli:usage": "cd ../cli && node dist/cli.js usage",
    "cli:environmental": "cd ../cli && node dist/cli.js environmental",
    "cli:fluency": "cd ../cli && node dist/cli.js fluency",
    "cli": "cd ../cli && node dist/cli.js",
    "generate:webview-strings": "node scripts/generate-webview-strings.mjs",
    "check:webview-strings": "node scripts/generate-webview-strings.mjs --check",
    "lint:locale": "node scripts/check-bare-tolocale.mjs"
  },
