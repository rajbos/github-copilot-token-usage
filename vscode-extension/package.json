{
  "name": "ai-engineering-fluency",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.19.1",
  "publisher": "RobBos",
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.134.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rajbos/ai-engineering-fluency"
  },
  "author": {
    "name": "Rob Bos",
    "email": "rob@example.com"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Repository hygiene analysis runs `git` commands and scans files inside the workspace folder, so it is disabled in untrusted workspaces. Token/session usage tracking, dashboards, and insights only read AI session logs from your user home directory and continue to work normally."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Repository hygiene analysis relies on a local `git` checkout and workspace filesystem access, so it is disabled for virtual workspaces. Token/session usage tracking, dashboards, and insights only read AI session logs from your user home directory and continue to work normally."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aiEngineeringFluency.refresh",
        "title": "%command.refresh.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showDetails",
        "title": "%command.showDetails.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showChart",
        "title": "%command.showChart.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showUsageAnalysis",
        "title": "%command.showUsageAnalysis.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.openMcpJson",
        "title": "%command.openMcpJson.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.generateDiagnosticReport",
        "title": "%command.generateDiagnosticReport.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showMaturity",
        "title": "%command.showMaturity.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showReadiness",
        "title": "%command.showReadiness.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.showFluencyLevelViewer",
        "title": "%command.showFluencyLevelViewer.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.runLocalViewRegression",
        "title": "%command.runLocalViewRegression.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.configureBackend",
        "title": "%command.configureBackend.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.configureTeamServer",
        "title": "%command.configureTeamServer.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.copyBackendConfig",
        "title": "%command.copyBackendConfig.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.exportCurrentView",
        "title": "%command.exportCurrentView.title%",
        "category": "AI Engineering Fluency"
      },
      {
        "command": "aiEngineeringFluency.setBackendSharedKey",
