  "packageManager": "pnpm@11.2.2",
  "overrides": {
    "@azure/msal-node": "5.1.4",
    "@babel/core": ">=7.29.6",
    "brace-expansion": ">=5.0.12",
    "js-yaml": ">=4.3.2 <5.0.0",
